{
	"name": "grocery-list",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"prepare": "lefthook install",
		"tasks": "docker compose up -d tasks && echo Tasks.md board running at http://localhost:8338",
		"tasks:stop": "docker compose stop tasks"
	},
	"dependencies": {
		"next": "16.2.10",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.10",
		"lefthook": "^2.1.10",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
